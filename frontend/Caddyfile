    email zodeyash98@gmail.com
}

{$SITE_ADDRESS::80} {
    root * /srv
    encode gzip

    # API proxy → gateway container
    handle /api/* {
        reverse_proxy openclaw-gateway:18789 {
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Baserow API proxy — token injected server-side
    handle_path /baserow/* {
        rewrite * /api/database/rows{uri}
        reverse_proxy https://api.baserow.io {
            header_up Host api.baserow.io
            header_up Authorization "Token {$BASEROW_TOKEN}"
            header_up Content-Type application/json
            header_up Accept application/json
            transport http {
                tls_server_name api.baserow.io
            }
        }
    }

    # Telegram Bot API proxy — welcome message after web auth
    handle /tg/sendMessage {
        @notpost not method POST
        respond @notpost 403

        rewrite * /bot{$TELEGRAM_BOT_TOKEN}/sendMessage
        reverse_proxy https://api.telegram.org {
            header_up Host api.telegram.org
            header_up Content-Type application/json
            transport http {
                tls_server_name api.telegram.org
            }
        }
    }

    # SPA catch-all — static assets + fallback to index.html
    handle {
        @static path *.js *.css *.png *.jpg *.jpeg *.gif *.ico *.svg *.woff *.woff2 *.ttf *.eot
        header @static Cache-Control "public, max-age=31536000, immutable"
        try_files {path} /index.html
        file_server
    }
}
